configure terminal
hostname R3
interface lo
 ip address 192.168.3.1/24
exit
route-map RM-FROM-CUSTOMER permit 10
 set local-preference 200
exit
route-map RM-FROM-PEER permit 10
 set local-preference 150
exit
route-map RM-FROM-PROVIDER permit 10
 set local-preference 100
exit
router bgp 6500
 bgp router-id 192.168.3.1
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 neighbor 10.2.3.2 remote-as 65200
 neighbor 10.2.3.2 description PEER_R2_via_ens3
 neighbor 10.1.3.1 remote-as 64501
 neighbor 10.1.3.1 description UPSTREAM_R1_via_ens4
 neighbor 10.3.4.4 remote-as 65201
 neighbor 10.3.4.4 description PEER_R4_via_ens5
 neighbor 10.3.7.7 remote-as 65102
 neighbor 10.3.7.7 description CUSTOMER_R7_via_ens6
 neighbor 10.3.6.6 remote-as 65101
 neighbor 10.3.6.6 description CUSTOMER_R6_via_ens7
 address-family ipv4 unicast
  network 192.168.3.0/24
  neighbor 10.2.3.2 activate
  neighbor 10.1.3.1 activate
  neighbor 10.3.4.4 activate
  neighbor 10.3.7.7 activate
  neighbor 10.3.6.6 activate
  neighbor 10.1.3.1 route-map RM-FROM-PROVIDER in
  neighbor 10.2.3.2 route-map RM-FROM-PEER in
  neighbor 10.3.4.4 route-map RM-FROM-PEER in
  neighbor 10.3.6.6 route-map RM-FROM-CUSTOMER in
  neighbor 10.3.7.7 route-map RM-FROM-CUSTOMER in
 exit-address-family
exit
end
write memory
