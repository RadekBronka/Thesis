configure terminal
hostname R6
interface lo
 ip address 192.168.6.1/24
exit
router bgp 65101
 bgp router-id 192.168.6.1
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 neighbor 10.3.6.3 remote-as 6500
 neighbor 10.3.6.3 description PROVIDER_R3_via_ens3
 address-family ipv4 unicast
  network 192.168.6.0/24
  neighbor 10.3.6.3 activate
 exit-address-family
exit
end
write memory
